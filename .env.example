# ============================================================
# PERSONAL BLOG & DIGITAL JOURNAL - ENVIRONMENT CONFIGURATION
# ============================================================

# Supabase Project URL (Dapatkan dari Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (Aman digunakan di browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (RAHASIA! Hanya berjalan di server untuk verifikasi token kepemilikan komentar)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# URL Website (opsional untuk production metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

